{
  "name": "cssct-cs2e",
  "compatibility_date": "2026-07-28",
  "main": "src/worker.js",
  "keep_vars": true,
  // Rappels programmés (notifications) : le Worker se réveille chaque heure pile ; il n'envoie que
  // aux appareils dont l'heure choisie est atteinte (voir notifications.html).
  "triggers": { "crons": ["0 * * * *"] },
  // Activé pour pouvoir consulter l'historique des requêtes/erreurs du Worker depuis
  // le tableau de bord Cloudflare (Workers & Pages > le Worker > onglet "Observability"),
  // sans avoir besoin d'avoir un flux de logs ouvert au moment exact du problème.
  // Nécessite un redéploiement pour prendre effet (npx wrangler deploy, ou republier le code).
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    }
  },
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // Par défaut (false), Cloudflare sert les fichiers statiques (toutes les pages .html)
    // directement depuis son cache, SANS exécuter worker.js. Résultat découvert en vérifiant le
    // déploiement en production : les en-têtes de sécurité et la CSP (voir plus bas) n'étaient
    // appliqués qu'aux endpoints /api/... et jamais aux pages elles-mêmes. Mis à true pour que
    // CHAQUE requête passe par le fetch() de worker.js (qui renvoie ensuite les pages via
    // env.ASSETS.fetch comme avant) et reçoive bien les en-têtes de sécurité.
    "run_worker_first": true
  },
  // Stockage des fichiers PDF/Word des comptes-rendus de réunion (voir
  // claude/mode-operatoire-multi-cssct.md). À créer une fois avec :
  //   wrangler kv namespace create CR_FILES
  // puis remplacer "REMPLACER_PAR_ID_NAMESPACE" ci-dessous par l'id retourné.
  "kv_namespaces": [
    { "binding": "CR_FILES", "id": "3e71a74bb3354863b7834eaf146d478b" }
  ],
  // Limitation de débit anti-abus sur les formulaires publics et le mot de passe CR (voir
  // claude/mode-operatoire-multi-cssct.md). Contrairement à la KV ci-dessus, rien à créer dans le
  // tableau de bord Cloudflare : ces deux compteurs sont définis uniquement ici et activés au
  // prochain déploiement (npx wrangler deploy). "namespace_id" est un simple numéro choisi
  // arbitrairement (pas un identifiant existant à récupérer) ; les deux limiteurs utilisent des
  // numéros différents pour ne pas partager leur compteur.
  "ratelimits": [
    { "name": "RATE_LIMITER_FORMS", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } },
    { "name": "RATE_LIMITER_CR_PASSWORD", "namespace_id": "1002", "simple": { "limit": 5, "period": 60 } }
  ]
}
